# Supabase (handled for you in this build; replace if you fork the project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App + Auth (accounts are OFF until you set NEXT_PUBLIC_AUTH_ENABLED=true)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_ENABLED=
# Server-only secret used to encrypt stored OAuth tokens (generate a long random string)
FLOWMIND_TOKEN_ENCRYPTION_SECRET=

# Google Sign-In / Drive connector (separate concepts — Drive access is per-file)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, for the Google Picker (next step)
GOOGLE_API_KEY=
GOOGLE_PICKER_API_KEY=

# GitHub repo connection / export / PR workflow (Prompt 10).
# GitHub LOGIN ≠ repo access — repo access uses a GitHub App so permissions are repo-scoped.
# Tokens are minted server-side from the App private key and are NEVER exported. (Prefer the
# GitHub App over personal access tokens.) Do not commit real values.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the App private key PEM (newlines may be \n-escaped on a single line)
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Public — the App's URL slug (github.com/apps/<slug>)
NEXT_PUBLIC_GITHUB_APP_SLUG=
# Optional OAuth-app fallback (only if not using a GitHub App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Anthropic — REQUIRED for generation + runs. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional Flowmind model-router defaults
FLOWMIND_DEFAULT_REASONING_MODEL=
FLOWMIND_DEFAULT_FAST_MODEL=
FLOWMIND_DEFAULT_STRUCTURED_MODEL=
FLOWMIND_DEFAULT_VISION_MODEL=
FLOWMIND_DEFAULT_EVALUATOR_MODEL=

# Optional model providers (status only until adapters are wired)
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Optional tools / APIs
GOOGLE_PLACES_API_KEY=
SERPAPI_API_KEY=
RENTCAST_API_KEY=
ATTOM_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Billing / credits / plans (Prompt 11). OFF by default — the public demo runs unlimited/free.
# Flip NEXT_PUBLIC_BILLING_ENABLED=true to enforce plan limits + credit gating. Stripe secret
# key is server-only and never sent to the client. Do not commit real values.
NEXT_PUBLIC_BILLING_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
# Optional one-time credit packs
STRIPE_PRICE_CREDITS_SMALL=
STRIPE_PRICE_CREDITS_MEDIUM=
STRIPE_PRICE_CREDITS_LARGE=

# Rate limiting for token-spending AI endpoints (Prompt 10). Server-only. When both URL + token
# are set, authenticated AI routes get a per-user sliding-window limit; when unset, rate limiting
# is OFF (auth still required). If configured but Redis is unreachable, AI routes fail closed (429).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional limit tuning (no redeploy needed). Defaults: 20/min, 500/day per user.
RATELIMIT_PER_MINUTE=
RATELIMIT_PER_DAY=
