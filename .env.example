# Supabase (handled for you in this build; replace if you fork the project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App + Auth (accounts are OFF until you set NEXT_PUBLIC_AUTH_ENABLED=true)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_ENABLED=
# Server-only secret used to encrypt stored OAuth tokens (generate a long random string)
FLOWMIND_TOKEN_ENCRYPTION_SECRET=

# Google Sign-In / Drive connector (separate concepts — Drive access is per-file)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, for the Google Picker (next step)
GOOGLE_API_KEY=
GOOGLE_PICKER_API_KEY=

# Anthropic — REQUIRED for generation + runs. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional Flowmind model-router defaults
FLOWMIND_DEFAULT_REASONING_MODEL=
FLOWMIND_DEFAULT_FAST_MODEL=
FLOWMIND_DEFAULT_STRUCTURED_MODEL=
FLOWMIND_DEFAULT_VISION_MODEL=
FLOWMIND_DEFAULT_EVALUATOR_MODEL=

# Optional model providers (status only until adapters are wired)
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Optional tools / APIs
GOOGLE_PLACES_API_KEY=
SERPAPI_API_KEY=
RENTCAST_API_KEY=
ATTOM_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
